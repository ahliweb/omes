# BEGIN OMES graphify ignore patterns (omes graphify init-ignore, issue #55)
#
# gitignore-style patterns. Verified 2026-09-19 against graphify 0.9.64:
# `graphify extract` honors BOTH this file and .gitignore/.git/info/exclude
# by default (no flag needed); `--no-gitignore` additionally disables
# .gitignore/.git/info/exclude parsing specifically, in favor of this file
# alone - see docs/graphify-privacy.md and docs/graphify.md §1.5 for the
# local-vs-external processing boundary this file helps enforce.
#
# This is a starting point, not a substitute for reviewing what a given
# repository actually contains before running a semantic (non
# --code-only) extraction pass - see docs/graphify-privacy.md.

# --- Secrets and credentials ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*_rsa
*_ed25519
credentials.json
credentials*.json
*.credentials
secrets.yml
secrets.yaml
.aws/
.ssh/
.gnupg/

# --- Dependency / build directories (noisy, rarely useful to extract) ---
node_modules/
vendor/
.venv/
venv/
__pycache__/
dist/
build/
target/

# --- Graphify's own output and OMES-managed vault export ---
# The default vault subdirectory name (docs/graphify.md §5) - adjust if
# OMES_GRAPHIFY_VAULT_SUBDIR is customized.
graphify-out/
graphify/

# --- Personal notes / other vaults a repo might happen to contain ---
*.obsidian/

# END OMES graphify ignore patterns
