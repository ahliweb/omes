{
  "apiVersion": "omes.ahliweb.com/v2",
  "kind": "RuntimeDeployment",
  "metadata": {
    "name": "analyst-shared",
    "workspace": "ahliweb",
    "environment": "production"
  },
  "runtime": {
    "kind": "hermes",
    "profileRef": "researcher"
  },
  "placement": {
    "backend": "compose",
    "serviceScope": "user",
    "restartPolicy": "always"
  },
  "security": {
    "isolationClass": "standard"
  },
  "resources": {
    "memory": "1G",
    "cpu": "1.0",
    "pids": 128
  },
  "compose": {
    "topology": "shared",
    "image": "ghcr.io/nousresearch/hermes-agent@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    "user": "1000:1000",
    "capDrop": ["ALL"]
  }
}
