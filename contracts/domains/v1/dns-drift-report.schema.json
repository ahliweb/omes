{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/dns-drift-report.schema.json",
  "title": "dns-drift-report",
  "type": "object",
  "required": [
    "zone_id",
    "provider",
    "checked_at",
    "drift"
  ],
  "additionalProperties": false,
  "properties": {
    "zone_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cloudflare",
        "srsx",
        "manual"
      ]
    },
    "checked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "kind"
        ],
        "additionalProperties": true,
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "missing_at_provider",
              "mismatch",
              "unmanaged_at_provider"
            ]
          }
        }
      }
    }
  }
}
