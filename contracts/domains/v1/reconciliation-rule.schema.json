{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/reconciliation-rule.schema.json",
  "title": "reconciliation-rule",
  "type": "object",
  "required": [
    "rule_id",
    "state_domain",
    "authoritative_source",
    "reconciled_with",
    "last_reconciled_at",
    "drift_detected"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "state_domain": {
      "type": "string",
      "enum": [
        "registrar",
        "invoice",
        "entitlement",
        "dns"
      ]
    },
    "authoritative_source": {
      "type": "string",
      "enum": [
        "registrar",
        "invoice",
        "entitlement",
        "dns",
        "omes_ledger"
      ]
    },
    "reconciled_with": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "registrar",
          "invoice",
          "entitlement",
          "dns"
        ]
      }
    },
    "last_reconciled_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "drift_detected": {
      "type": "boolean"
    }
  }
}
