{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/github-disconnect.request.schema.json",
  "title": "github-disconnect.request",
  "type": "object",
  "required": [
    "tenant_id",
    "correlation_id",
    "idempotency_key",
    "actor",
    "installation_id",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,256}$"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "customer_requested",
        "tenant_offboarded",
        "security_revocation",
        "app_uninstalled_upstream"
      ]
    }
  }
}
