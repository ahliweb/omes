{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/credential-reference.schema.json",
  "title": "credential-reference",
  "type": "object",
  "required": [
    "reference_id",
    "provider",
    "kind",
    "reference"
  ],
  "additionalProperties": false,
  "properties": {
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cloudflare",
        "srsx",
        "manual"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "api_token",
        "api_username_password",
        "oauth_app_installation"
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "store",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "store": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./:-]{1,256}$"
        }
      }
    },
    "secondary_reference": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "store",
            "key"
          ],
          "additionalProperties": false,
          "properties": {
            "store": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./:-]{1,256}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
