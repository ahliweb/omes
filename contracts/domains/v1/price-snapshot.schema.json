{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/price-snapshot.schema.json",
  "title": "price-snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "provider",
    "tld",
    "operation",
    "term_years",
    "provider_cost_minor",
    "customer_price_minor",
    "currency",
    "tax_class",
    "premium",
    "captured_at"
  ],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cloudflare",
        "srsx",
        "manual"
      ]
    },
    "tld": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,63}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "registration",
        "renewal",
        "transfer"
      ]
    },
    "term_years": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "provider_cost_minor": {
      "type": "integer",
      "minimum": 0
    },
    "customer_price_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "tax_class": {
      "type": "string",
      "enum": [
        "standard",
        "exempt",
        "reverse_charge"
      ]
    },
    "premium": {
      "type": "boolean"
    },
    "effective_until": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
