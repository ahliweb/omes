{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/github-provider-observation.schema.json",
  "title": "github-provider-observation",
  "type": "object",
  "required": [
    "tenant_id",
    "observation_type",
    "repository_full_name",
    "source_url",
    "last_synced_at",
    "resource"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "observation_type": {
      "type": "string",
      "enum": [
        "repository",
        "commit",
        "release",
        "workflow_run",
        "deployment",
        "environment"
      ]
    },
    "repository_full_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}$"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9._/-]{1,512}$"
    },
    "last_synced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "resource": {
      "type": "object"
    }
  }
}
