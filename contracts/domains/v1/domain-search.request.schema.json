{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/domain-search.request.schema.json",
  "title": "domain-search.request",
  "type": "object",
  "required": [
    "tenant_id",
    "correlation_id",
    "actor",
    "query"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      }
    },
    "query": {
      "type": "string",
      "minItems": 1,
      "pattern": "^[A-Za-z0-9-]{1,63}$"
    },
    "tlds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,63}$"
      }
    }
  }
}
