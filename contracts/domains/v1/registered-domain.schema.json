{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/registered-domain.schema.json",
  "title": "registered-domain",
  "type": "object",
  "required": [
    "domain",
    "provider",
    "provider_domain_id",
    "status",
    "expires_at",
    "locked",
    "auto_renew",
    "privacy_enabled",
    "last_synced_at"
  ],
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cloudflare",
        "srsx",
        "manual"
      ]
    },
    "provider_domain_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "pending_delete",
        "action_required"
      ]
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "locked": {
      "type": "boolean"
    },
    "auto_renew": {
      "type": "boolean"
    },
    "privacy_enabled": {
      "type": "boolean"
    },
    "last_synced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
