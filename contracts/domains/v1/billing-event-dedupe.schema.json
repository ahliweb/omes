{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/billing-event-dedupe.schema.json",
  "title": "billing-event-dedupe",
  "type": "object",
  "required": [
    "event_id",
    "source",
    "idempotency_key",
    "first_seen_at"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "payment_provider",
        "registrar",
        "dns",
        "github"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,256}$"
    },
    "first_seen_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
