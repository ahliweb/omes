{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/domains/v1/registration-poll.response.schema.json",
  "title": "registration-poll.response",
  "type": "object",
  "required": [
    "tenant_id",
    "correlation_id",
    "order_id",
    "provider",
    "status",
    "polled_at",
    "attempt",
    "timed_out"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "cloudflare",
        "srsx",
        "manual"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "action_required",
        "failed",
        "succeeded",
        "blocked"
      ]
    },
    "polled_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "timed_out": {
      "type": "boolean"
    }
  }
}
