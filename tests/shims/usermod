#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/usermod - fake usermod for bats tests
# (#7, modules/containers docker-group opt-in).
#
#   SHIM_USERMOD_EXIT   exit code (default 0)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'usermod %s\n' "$*" >>"$SHIM_LOG"
fi

exit "${SHIM_USERMOD_EXIT:-0}"
