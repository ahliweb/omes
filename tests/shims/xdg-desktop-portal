#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/xdg-desktop-portal - fake xdg-desktop-portal daemon binary
# for bats tests.
#
# Only ever invoked (in tests) via `command -v xdg-desktop-portal` /
# `PATH` resolution from modules/hyprland-session/module.sh's
# module_verify, which checks that the portal daemon binary resolves after
# apply - matching the Hyprland binary check. Never actually executed as
# a long-running daemon in tests.

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'xdg-desktop-portal %s\n' "$*" >> "$SHIM_LOG"
fi

exit 0
