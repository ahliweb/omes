#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/pipx - fake `pipx` CLI for bats tests (modules/graphify, issue #50).
#
# Logs every invocation (space-joined argv) to $SHIM_LOG and returns
# success by default, with plausible output for the subcommands
# modules/graphify/module.sh and lib/omes/cmd/graphify.sh actually run:
# `pipx install/upgrade/uninstall <pkgspec>`.
#
#   SHIM_PIPX_EXIT   exit code for any subcommand (default 0)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'pipx %s\n' "$*" >>"$SHIM_LOG"
fi

exit "${SHIM_PIPX_EXIT:-0}"
