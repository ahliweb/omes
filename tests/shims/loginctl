#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/loginctl - fake loginctl for bats tests (#12).
#
# modules/hermes-gateway only ever calls `loginctl enable-linger <user>`
# (via `sudo loginctl ...`, so this shim is invoked through tests/shims/sudo)
# and, on rollback, `loginctl disable-linger <user>`. Behavior:
#
#   SHIM_LOGINCTL_ENABLE_EXIT    exit code for `enable-linger` (default 0)
#   SHIM_LOGINCTL_DISABLE_EXIT   exit code for `disable-linger` (default 0)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'loginctl %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  enable-linger)
    exit "${SHIM_LOGINCTL_ENABLE_EXIT:-0}"
    ;;
  disable-linger)
    exit "${SHIM_LOGINCTL_DISABLE_EXIT:-0}"
    ;;
  *)
    exit 0
    ;;
esac
