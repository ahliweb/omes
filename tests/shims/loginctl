#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/loginctl - fake loginctl for bats tests.
#
# modules/hermes-gateway calls `loginctl enable-linger <user>` (via `sudo
# loginctl ...`, so this shim is invoked through tests/shims/sudo) and, on
# rollback, `loginctl disable-linger <user>`. Behavior:
#
#   SHIM_LOGINCTL_ENABLE_EXIT    exit code for `enable-linger` (default 0)
#   SHIM_LOGINCTL_DISABLE_EXIT   exit code for `disable-linger` (default 0)
#
# modules/desktop-preflight/checks.sh's dp_check_logind calls
# `loginctl list-sessions`, which succeeds (prints a fake session line)
# unless $SHIM_LOGINCTL_FAIL=1, which simulates systemd-logind being
# unreachable.
#
# Extended for #7 (modules/containers): `loginctl show-user <user>` is
# used as a rootless-Docker prerequisite check ("does this user have an
# active systemd user session"). Succeeds only for users listed
# (space-separated) in $SHIM_LOGINCTL_KNOWN_USERS, unless
# $SHIM_LOGINCTL_SHOW_USER_EXIT is set, which overrides the exit code
# unconditionally.
#
#   SHIM_LOGINCTL_KNOWN_USERS      space-separated users with a session
#   SHIM_LOGINCTL_SHOW_USER_EXIT   overrides `show-user`'s exit code

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'loginctl %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  enable-linger)
    exit "${SHIM_LOGINCTL_ENABLE_EXIT:-0}"
    ;;
  disable-linger)
    exit "${SHIM_LOGINCTL_DISABLE_EXIT:-0}"
    ;;
  list-sessions)
    if [[ "${SHIM_LOGINCTL_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    printf 'SESSION UID USER SEAT TTY\n'
    printf '1       1000 user seat0 -\n'
    exit 0
    ;;
  show-user)
    if [[ -n "${SHIM_LOGINCTL_SHOW_USER_EXIT:-}" ]]; then
      exit "${SHIM_LOGINCTL_SHOW_USER_EXIT}"
    fi
    user="${2:-}"
    for u in ${SHIM_LOGINCTL_KNOWN_USERS:-}; do
      [[ "$u" == "$user" ]] && exit 0
    done
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
