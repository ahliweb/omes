#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/timedatectl - fake timedatectl for bats tests
# (#7, modules/security-baseline).
#
# Understands `timedatectl show -p NTPSynchronized --value`, the only
# invocation _security_ntp_synced makes.
#
#   SHIM_TIMEDATECTL_NTP_SYNC   "yes" or "no" (default "yes")

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'timedatectl %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  show)
    printf '%s\n' "${SHIM_TIMEDATECTL_NTP_SYNC:-yes}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
