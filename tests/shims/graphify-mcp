#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/graphify-mcp - fake `graphify-mcp` console script for bats
# tests (issue #52's graphify-mcp module and `omes graphify mcp health`).
#
# This shim's PRESENCE on PATH is the thing under test ("is graphify-mcp
# installed"), unlike tests/shims/graphify's --version-based simulation -
# so tests that need to simulate "not installed" strip this shim's
# directory from PATH entirely (safe: tests/shims/ never contains real
# system coreutils, unlike a directory like /usr/bin) rather than using an
# env var here.
#
#   SHIM_GRAPHIFY_MCP_HELP_EXIT   exit code for `graphify-mcp --help`/`-h`
#                                 (default 0)
#
# Any other invocation (e.g. actually starting the stdio server) is a
# no-op success - this shim never blocks, so a test can never hang on it.

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'graphify-mcp %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  --help | -h)
    exit "${SHIM_GRAPHIFY_MCP_HELP_EXIT:-0}"
    ;;
  *)
    exit 0
    ;;
esac
