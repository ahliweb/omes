#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/ollama - fake `ollama` CLI for bats tests (issue #71).
#
# The layered health check (lib/omes/py/health/ollama.py) talks to the
# Ollama HTTP API directly, not this CLI; this shim exists so
# `command -v ollama` / `shutil.which("ollama")` based "binary present"
# checks (modules/hermes/module.sh's module_doctor, the health checker's
# service layer) see a binary on PATH in tests without needing a real
# Ollama install.
#
#   SHIM_OLLAMA_VERSION   `ollama --version` output (default "0.0.0-test")
#   SHIM_OLLAMA_PS_OUTPUT `ollama ps` output (default empty)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'ollama %s\n' "$*" >> "$SHIM_LOG"
fi

case "${1:-}" in
  --version)
    printf 'ollama version is %s\n' "${SHIM_OLLAMA_VERSION:-0.0.0-test}"
    exit 0
    ;;
  ps)
    printf '%s\n' "${SHIM_OLLAMA_PS_OUTPUT:-}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
