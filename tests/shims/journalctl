#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/journalctl - fake journalctl for bats tests.
#
# Prints $SHIM_JOURNALCTL_OUTPUT (default empty - "no matching entries").
# Used by modules/hyprland-session/module.sh's best-effort
# _hs_doctor_best_effort crash check; never fails.

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'journalctl %s\n' "$*" >> "$SHIM_LOG"
fi

if [[ -n "${SHIM_JOURNALCTL_OUTPUT:-}" ]]; then
  printf '%s\n' "$SHIM_JOURNALCTL_OUTPUT"
fi
exit 0
