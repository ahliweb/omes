#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/gpasswd - fake gpasswd for bats tests
# (#7, modules/containers module_rollback).
#
#   SHIM_GPASSWD_EXIT   exit code (default 0)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'gpasswd %s\n' "$*" >> "$SHIM_LOG"
fi

exit "${SHIM_GPASSWD_EXIT:-0}"
