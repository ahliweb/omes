#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/lspci - fake lspci for bats tests.
#
# Prints $SHIM_LSPCI_OUTPUT (default a benign single VGA line) so
# detect_gpu has something deterministic to parse.

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'lspci %s\n' "$*" >> "$SHIM_LOG"
fi

if [[ -n "${SHIM_LSPCI_OUTPUT:-}" ]]; then
  printf '%s\n' "$SHIM_LSPCI_OUTPUT"
else
  printf '00:02.0 VGA compatible controller: Example GPU\n'
fi
