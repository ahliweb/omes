#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/chromium - fake chromium/google-chrome CLI for bats tests
# (issue #83). Installed under both a symlink named `chromium` and one
# named `google-chrome`, since versions.py tries both binary names in
# order.
#
#   SHIM_CHROMIUM_VERSION   version string (default "Chromium 122.0.6261.94")

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'chromium %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  --version)
    printf '%s\n' "${SHIM_CHROMIUM_VERSION:-Chromium 122.0.6261.94 unofficial}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
