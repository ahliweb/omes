#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/graphify - fake graphify CLI for bats tests (issue #50).
#
# Records every invocation (space-joined argv) to $SHIM_LOG. Behavior is
# driven entirely by env vars, mirroring tests/shims/hermes:
#
#   SHIM_GRAPHIFY_ABSENT      unset/0 (default) => `graphify --version` and
#                             `graphify --help` behave as if graphify is
#                             installed; 1 => both fail, simulating "not
#                             yet installed" even though this shim file is
#                             always on PATH (command -v graphify always
#                             succeeds; "installed" is judged purely by
#                             --version succeeding, exactly like the
#                             hermes shim).
#   SHIM_GRAPHIFY_VERSION     version string `graphify --version` prints
#                             (default: 0.9.64, the version verified
#                             2026-09-19 - see docs/graphify.md).
#   SHIM_GRAPHIFY_HELP_EXIT   exit code for `graphify --help` (default 0),
#                             ignored when SHIM_GRAPHIFY_ABSENT=1.
#   SHIM_GRAPHIFY_EXPORT_OBSIDIAN_FAIL
#                             1 => `graphify export obsidian` exits 1 and
#                             writes nothing, simulating an upstream
#                             failure so callers exercise the OMES-own
#                             renderer fallback (issue #53,
#                             docs/graphify.md §5.1/§5.2). Default: 0
#                             (succeeds, producing a small, realistic
#                             vault-ready export - one Markdown note with
#                             upstream's own YAML front matter, a canvas
#                             file, a nested .obsidian/graph.json, and
#                             upstream's own .graphify_obsidian_manifest.json
#                             - verified 2026-09-19 against graphify
#                             0.9.64's real `export obsidian` output shape).

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'graphify %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  --version)
    if [[ "${SHIM_GRAPHIFY_ABSENT:-0}" == "1" ]]; then
      exit 1
    fi
    printf 'graphify %s\n' "${SHIM_GRAPHIFY_VERSION:-0.9.64}"
    exit 0
    ;;
  --help)
    if [[ "${SHIM_GRAPHIFY_ABSENT:-0}" == "1" ]]; then
      exit 127
    fi
    exit "${SHIM_GRAPHIFY_HELP_EXIT:-0}"
    ;;
  export)
    if [[ "${2:-}" == "obsidian" ]]; then
      shift 2
      dir=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --dir)
            dir="$2"
            shift 2
            ;;
          *)
            shift
            ;;
        esac
      done

      if [[ "${SHIM_GRAPHIFY_EXPORT_OBSIDIAN_FAIL:-0}" == "1" ]]; then
        exit 1
      fi

      dir="${dir:-vault-export}"
      mkdir -p "${dir}/.obsidian"
      cat >"${dir}/app.py.md" <<'NOTEEOF'
---
source_file: "src/app.py"
type: "code"
community: "Community 0"
location: "L1"
tags:
  - graphify/code
  - graphify/EXTRACTED
  - community/Community_0
---

# app.py

## Connections
- [[greet()]] - `contains` [EXTRACTED]
- [[main()]] - `contains` [EXTRACTED]

#graphify/code #graphify/EXTRACTED #community/Community_0
NOTEEOF
      printf '{"nodes":[],"edges":[]}\n' >"${dir}/graph.canvas"
      printf '{}\n' >"${dir}/.obsidian/graph.json"
      printf '{"files": [".obsidian/graph.json", "app.py.md", "graph.canvas"]}\n' \
        >"${dir}/.graphify_obsidian_manifest.json"
      printf 'Obsidian vault: 1 notes in %s/\n' "$dir"
      exit 0
    fi
    exit 0
    ;;
  extract)
    # Used both by `omes graphify run` (issue #51, no file assertions
    # rely on this) and `omes graphify sync`'s first-run path (issue
    # #54, which DOES check the resulting graph.json). Supports --out
    # (writes <out>/graphify-out/graph.json, matching real graphify's
    # own "--out DIR ... writes <DIR>/graphify-out/" behavior) alongside
    # the default <path>/graphify-out/graph.json.
    #   SHIM_GRAPHIFY_EXTRACT_FAIL   1 => exit 1, writes nothing.
    shift
    extract_path="${1:-.}"
    extract_out=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --out | --output)
          extract_out="$2"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [[ "${SHIM_GRAPHIFY_EXTRACT_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    extract_out_dir="${extract_out:-$extract_path}/graphify-out"
    mkdir -p "$extract_out_dir"
    printf '{"nodes": [{"id": "f1", "type": "file", "path": "src/a.py"}], "edges": []}\n' \
      >"${extract_out_dir}/graph.json"
    exit 0
    ;;
  update)
    # Simulates upstream `graphify update <path>` (issue #54,
    # docs/graphify.md §6.1) - always in-place at <path>/graphify-out/,
    # no --out support (matching the real command's own --help).
    #   SHIM_GRAPHIFY_UPDATE_FAIL      1 => exit 1, writes nothing.
    #   SHIM_GRAPHIFY_UPDATE_CORRUPT   1 => exit 0 but leaves graph.json
    #                                   truncated/invalid, simulating an
    #                                   interrupted run for the recovery
    #                                   test.
    shift
    update_path="${1:-.}"
    if [[ "${SHIM_GRAPHIFY_UPDATE_FAIL:-0}" == "1" ]]; then
      exit 1
    fi
    update_out_dir="${update_path}/graphify-out"
    mkdir -p "$update_out_dir"
    if [[ "${SHIM_GRAPHIFY_UPDATE_CORRUPT:-0}" == "1" ]]; then
      printf 'not valid json {{{' >"${update_out_dir}/graph.json"
      exit 0
    fi
    printf '{"nodes": [{"id": "f1", "type": "file", "path": "src/a.py"}, {"id": "f2", "type": "file", "path": "src/b.py"}], "edges": []}\n' \
      >"${update_out_dir}/graph.json"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
