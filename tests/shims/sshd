#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/sshd - fake sshd for bats tests (#7, modules/security-baseline).
#
# Understands only `sshd -T` (dump effective config), which
# _security_sshd_port greps for the `port` directive.
#
#   SHIM_SSHD_PORT       port `sshd -T` reports (default 22)
#   SHIM_SSHD_T_EXIT      exit code for `sshd -T` (default 0; non-zero
#                          simulates sshd being unreachable/misconfigured,
#                          forcing the caller to fall back to sshd_config)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'sshd %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  -T)
    if [[ "${SHIM_SSHD_T_EXIT:-0}" != "0" ]]; then
      exit "${SHIM_SSHD_T_EXIT}"
    fi
    printf 'port %s\n' "${SHIM_SSHD_PORT:-22}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
