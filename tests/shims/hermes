#!/usr/bin/env bash
# shellcheck shell=bash
# tests/shims/hermes - fake hermes CLI for bats tests.
#
# Records every invocation (space-joined argv) to $SHIM_LOG. Behavior is
# driven entirely by env vars so tests can simulate "not installed",
# "installed at version X", a passing/warning/failing `hermes doctor`, and
# gateway subcommand outcomes without any real Hermes install:
#
#   SHIM_HERMES_VERSION            unset/empty => `hermes --version` fails
#                                   (simulates "not installed"); set =>
#                                   `hermes --version` prints "hermes $SHIM_HERMES_VERSION"
#   SHIM_HERMES_DOCTOR_EXIT         exit code for `hermes doctor` (default 0)
#   SHIM_HERMES_DOCTOR_OUTPUT       output for `hermes doctor` (default "All checks passed")
#   SHIM_HERMES_GATEWAY_INSTALL_EXIT   exit code for `hermes gateway install` (default 0)
#   SHIM_HERMES_GATEWAY_STATUS_EXIT    exit code for `hermes gateway status` (default 0)
#   SHIM_HERMES_GATEWAY_STATUS_OUTPUT  output for `hermes gateway status` (default "running")
#   SHIM_HERMES_CONFIG_GET_<KEY>       value for `hermes config get <key>`, with
#                                      "." replaced by "_" and upper-cased
#                                      (e.g. SHIM_HERMES_CONFIG_GET_MODEL_PROVIDER
#                                      for `hermes config get model.provider`);
#                                      unset => `hermes config get <key>` exits 1
#                                      with an "unknown command" message (issue #83:
#                                      simulates a Hermes build that does not
#                                      support this subcommand at all, unless
#                                      SHIM_HERMES_CONFIG_GET_SUPPORTED=1 forces
#                                      a plain "not set" failure instead)

set -Eeuo pipefail

if [[ -n "${SHIM_LOG:-}" ]]; then
  printf 'hermes %s\n' "$*" >>"$SHIM_LOG"
fi

case "${1:-}" in
  --version)
    if [[ -z "${SHIM_HERMES_VERSION:-}" ]]; then
      exit 1
    fi
    printf 'hermes %s\n' "$SHIM_HERMES_VERSION"
    exit 0
    ;;
  doctor)
    if [[ "${SHIM_HERMES_DOCTOR_EXIT:-0}" != "0" ]]; then
      printf '%s\n' "${SHIM_HERMES_DOCTOR_OUTPUT:-FAIL: simulated doctor failure}" >&2
      exit "${SHIM_HERMES_DOCTOR_EXIT}"
    fi
    printf '%s\n' "${SHIM_HERMES_DOCTOR_OUTPUT:-All checks passed}"
    exit 0
    ;;
  config)
    shift || true
    case "${1:-}" in
      get)
        shift || true
        key="${1:-}"
        var_name="SHIM_HERMES_CONFIG_GET_$(printf '%s' "$key" | tr '.' '_' | tr '[:lower:]' '[:upper:]')"
        if [[ -n "${!var_name:-}" ]]; then
          printf '%s\n' "${!var_name}"
          exit 0
        fi
        if [[ "${SHIM_HERMES_CONFIG_GET_SUPPORTED:-0}" == "1" ]]; then
          printf 'not set\n' >&2
          exit 1
        fi
        printf 'unknown command "get" for "hermes config"\n' >&2
        exit 1
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  model)
    exit 0
    ;;
  profile)
    shift || true
    case "${1:-}" in
      list)
        if [[ "${SHIM_HERMES_PROFILE_LIST_EXIT:-0}" != "0" ]]; then
          printf '%s\n' "${SHIM_HERMES_PROFILE_LIST_OUTPUT:-FAIL: simulated profile list failure}" >&2
          exit "${SHIM_HERMES_PROFILE_LIST_EXIT}"
        fi
        if [[ -n "${SHIM_HERMES_PROFILES:-}" ]]; then
          tr ',' '\n' <<<"$SHIM_HERMES_PROFILES"
          exit 0
        fi
        printf 'default\nresearcher\nsysmon\n'
        exit 0
        ;;
      export)
        shift || true
        prof="${1:-default}"
        if [[ $# -gt 0 && "$1" != --* ]]; then
          shift
        fi
        out_path=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --output|-o)
              out_path="$2"
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        if [[ "${SHIM_HERMES_PROFILE_EXPORT_EXIT:-0}" != "0" ]]; then
          printf '%s\n' "${SHIM_HERMES_PROFILE_EXPORT_OUTPUT:-FAIL: simulated profile export failure}" >&2
          exit "${SHIM_HERMES_PROFILE_EXPORT_EXIT}"
        fi
        if [[ -z "$out_path" ]]; then
          out_path="${prof}.hermes-profile.tar.gz"
        fi
        mkdir -p "$(dirname "$out_path")"
        tmp_dir="$(mktemp -d)"
        printf '{"format":"native-hermes-profile","profile":"%s"}\n' "$prof" > "${tmp_dir}/profile.json"
        tar -czf "$out_path" -C "$tmp_dir" profile.json
        rm -rf "$tmp_dir"
        exit 0
        ;;
      import)
        shift || true
        if [[ "${SHIM_HERMES_PROFILE_IMPORT_EXIT:-0}" != "0" ]]; then
          printf '%s\n' "${SHIM_HERMES_PROFILE_IMPORT_OUTPUT:-FAIL: simulated profile import failure}" >&2
          exit "${SHIM_HERMES_PROFILE_IMPORT_EXIT}"
        fi
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  backup)
    shift || true
    out_path=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --output|-o)
          out_path="$2"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [[ "${SHIM_HERMES_BACKUP_EXIT:-0}" != "0" ]]; then
      printf '%s\n' "${SHIM_HERMES_BACKUP_OUTPUT:-FAIL: simulated backup failure}" >&2
      exit "${SHIM_HERMES_BACKUP_EXIT}"
    fi
    if [[ -z "$out_path" ]]; then
      out_path="hermes-backup.tar.gz"
    fi
    mkdir -p "$(dirname "$out_path")"
    tmp_dir="$(mktemp -d)"
    printf '{"format":"native-hermes-runtime","sensitive":true}\n' > "${tmp_dir}/backup.json"
    tar -czf "$out_path" -C "$tmp_dir" backup.json
    rm -rf "$tmp_dir"
    exit 0
    ;;
  import)
    shift || true
    if [[ "${SHIM_HERMES_IMPORT_EXIT:-0}" != "0" ]]; then
      printf '%s\n' "${SHIM_HERMES_IMPORT_OUTPUT:-FAIL: simulated import failure}" >&2
      exit "${SHIM_HERMES_IMPORT_EXIT}"
    fi
    exit 0
    ;;
  gateway)
    shift || true
    case "${1:-}" in
      install)
        if [[ "${SHIM_HERMES_GATEWAY_INSTALL_EXIT:-0}" != "0" ]]; then
          printf '%s\n' "${SHIM_HERMES_GATEWAY_INSTALL_OUTPUT:-FAIL: simulated gateway install failure}" >&2
          exit "${SHIM_HERMES_GATEWAY_INSTALL_EXIT}"
        fi
        prof="default"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              prof="$2"
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        if [[ "${SHIM_HERMES_MULTIPLEXED:-0}" == "1" ]]; then
          printf 'multiplexed gateway already active; secondary per-profile service not created\n'
          exit 0
        fi
        unit_name="hermes-gateway.service"
        if [[ "$prof" != "default" ]]; then
          unit_name="hermes-gateway-${prof}.service"
        fi
        user_systemd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
        mkdir -p "$user_systemd_dir"
        unit_file="${user_systemd_dir}/${unit_name}"
        if [[ ! -f "$unit_file" ]]; then
          printf '[Unit]\nDescription=Hermes Gateway (%s)\n\n[Service]\nExecStart=/usr/local/bin/hermes gateway start\n' "$prof" > "$unit_file"
        fi
        if [[ -n "${SHIM_USER_ENABLED_FILE:-}" ]]; then
          mkdir -p "$(dirname "$SHIM_USER_ENABLED_FILE")"
          grep -qx "$unit_name" "$SHIM_USER_ENABLED_FILE" 2>/dev/null || printf '%s\n' "$unit_name" >> "$SHIM_USER_ENABLED_FILE"
        fi
        exit 0
        ;;
      start)
        prof="default"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              prof="$2"
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        unit_name="hermes-gateway.service"
        if [[ "$prof" != "default" ]]; then
          unit_name="hermes-gateway-${prof}.service"
        fi
        systemctl --user start "$unit_name"
        exit $?
        ;;
      stop)
        prof="default"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              prof="$2"
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        unit_name="hermes-gateway.service"
        if [[ "$prof" != "default" ]]; then
          unit_name="hermes-gateway-${prof}.service"
        fi
        systemctl --user stop "$unit_name"
        exit $?
        ;;
      restart)
        prof="default"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --profile)
              prof="$2"
              shift 2
              ;;
            *)
              shift
              ;;
          esac
        done
        unit_name="hermes-gateway.service"
        if [[ "$prof" != "default" ]]; then
          unit_name="hermes-gateway-${prof}.service"
        fi
        systemctl --user restart "$unit_name"
        exit $?
        ;;
      status)
        if [[ "${SHIM_HERMES_MULTIPLEXED:-0}" == "1" ]]; then
          printf 'multiplexed gateway running (profiles: default, researcher)\n'
          exit 0
        fi
        printf '%s\n' "${SHIM_HERMES_GATEWAY_STATUS_OUTPUT:-running}"
        exit "${SHIM_HERMES_GATEWAY_STATUS_EXIT:-0}"
        ;;
      setup)
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
