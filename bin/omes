#!/usr/bin/env bash
# shellcheck shell=bash
# bin/omes - OMES CLI entry point.

set -Eeuo pipefail
IFS=$'\n\t'

OMES_SELF="$(readlink -f "$0")"
OMES_ROOT="$(cd "$(dirname "$OMES_SELF")/.." && pwd)"
export OMES_ROOT
unset OMES_SELF

# shellcheck source=lib/omes/core.sh
source "${OMES_ROOT}/lib/omes/core.sh"
# shellcheck source=lib/omes/log.sh
source "${OMES_ROOT}/lib/omes/log.sh"
# shellcheck source=lib/omes/json.sh
source "${OMES_ROOT}/lib/omes/json.sh"
# shellcheck source=lib/omes/detect.sh
source "${OMES_ROOT}/lib/omes/detect.sh"
# shellcheck source=lib/omes/state.sh
source "${OMES_ROOT}/lib/omes/state.sh"
# shellcheck source=lib/omes/backup.sh
source "${OMES_ROOT}/lib/omes/backup.sh"
# shellcheck source=lib/omes/module.sh
source "${OMES_ROOT}/lib/omes/module.sh"
# shellcheck source=lib/omes/pkg.sh
source "${OMES_ROOT}/lib/omes/pkg.sh"
# shellcheck source=lib/omes/restore.sh
source "${OMES_ROOT}/lib/omes/restore.sh"

omes_install_err_trap

declare -a OMES_CHECK_NAMES=()
declare -a OMES_CHECK_OK=()
declare -a OMES_CHECK_DETAILS=()
declare -a OMES_MANAGED_PATHS=()

OMES_PROFILE=""
declare -a OMES_SELECTED_MODULES=()
RESTORE_FROM=""
RESTORE_LIST=0
BACKUP_REASON=""
PURGE_PACKAGES=0

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

print_usage() {
  cat <<'EOF'
[omes] Usage: omes <command> [flags]

Commands:
  check       Run platform + module preflight checks (no mutation).
  install     Check-all-then-apply the requested profile/modules.
  status      Show platform, profile, per-module, backup, and log summary.
  modules     List available modules (scope, description, status).
  doctor      Run health checks (OK/WARN/FAIL); exits 0 unless a FAIL.
  version     Print the OMES version.
  help        Show this help.
  backup      Create an on-demand backup of all managed paths.
  restore     Restore files from a backup session (offline-safe).
  uninstall   Roll back applied modules and their managed paths.
  update      Fast-forward this checkout via git, then re-run 'check'.
EOF
  _omes_print_extension_commands
  cat <<'EOF'

Global flags:
  --profile <name>       server | desktop | hermes
  --module <name>        select a single module (repeatable)
  --dry-run              print planned actions, mutate nothing
  --json                 emit a single JSON object on stdout
  --yes                  auto-confirm mutating actions
  --verbose              print debug-level log lines to the console
  --log-file <path>      override the log file location
  --allow-docker-group   opt in to granting root-equivalent docker group access
  --from <timestamp>     (restore) pick a specific backup session
  --list                 (restore) list available backup sessions, then exit
  --reason <text>        (backup) short reason recorded in the session's META
  --purge-packages       (uninstall) also remove OMES-installed packages

Environment overrides:
  OMES_DRY_RUN=1, OMES_JSON=1, OMES_STATE_DIR, OMES_LOG_FILE, OMES_ROOT,
  OMES_NONINTERACTIVE=1

Exit codes:
  0 success                       6 module apply failed
  1 general/unexpected error      7 verification failed
  2 usage error                   8 network required but unavailable
  3 unsupported platform          9 backup/restore failed
  4 preflight failed             10 rollback failed
  5 privilege error
EOF
}

# ---------------------------------------------------------------------------
# JSON helpers shared by multiple commands
# ---------------------------------------------------------------------------

_omes_platform_json() {
  json_obj \
    "$(json_kv os_id "${OMES_OS_ID:-}")" \
    "$(json_kv os_version_id "${OMES_OS_VERSION_ID:-}")" \
    "$(json_kv os_codename "${OMES_OS_CODENAME:-}")" \
    "$(json_kv os_pretty "${OMES_OS_PRETTY:-}")" \
    "$(json_kv arch "${OMES_ARCH:-}")" \
    "$(json_kv tier "${OMES_OS_TIER:-}")" \
    "$(json_kv virt "${OMES_VIRT:-}")" \
    "$(json_kv session "${OMES_SESSION:-}")" \
    "$(json_kv privilege "${OMES_PRIVILEGE:-}")" \
    "$(json_kv network "${OMES_NETWORK:-}")"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Extension commands
#
# A file lib/omes/cmd/<name>.sh defines `cmd_<name>` (receiving the
# command's own positional arguments and flags) and a one-line
# `# omes-help: <summary>` header used by `omes help`. Global flags before
# the first non-global token are parsed by bin/omes as usual; everything
# from the first unrecognized token on is handed to the extension verbatim.
# ---------------------------------------------------------------------------

_omes_cmd_dir() {
  printf '%s\n' "${OMES_ROOT}/lib/omes/cmd"
}

# _omes_is_extension_command <name>
_omes_is_extension_command() {
  [[ "$1" =~ ^[a-z][a-z0-9-]*$ ]] && [[ -r "$(_omes_cmd_dir)/$1.sh" ]]
}

_omes_print_extension_commands() {
  local f name summary
  shopt -s nullglob
  local -a files=("$(_omes_cmd_dir)"/*.sh)
  shopt -u nullglob
  [[ "${#files[@]}" -gt 0 ]] || return 0
  printf '\nExtension commands:\n'
  for f in "${files[@]}"; do
    name="$(basename "$f" .sh)"
    summary="$(grep -m1 '^# omes-help:' "$f" | sed 's/^# omes-help:[[:space:]]*//')"
    printf '  %-11s %s\n' "$name" "${summary:-(no description)}"
  done
}

# _omes_run_extension_command <name> [args...]
_omes_run_extension_command() {
  local name="$1"
  shift
  # shellcheck disable=SC1090  # extension path is computed at runtime
  source "$(_omes_cmd_dir)/${name}.sh"
  if ! declare -F "cmd_${name}" >/dev/null 2>&1; then
    omes_die "$OMES_EX_ERROR" "extension command '${name}' does not define cmd_${name}"
  fi
  "cmd_${name}" "$@"
}

cmd_version() {
  if [[ "$OMES_JSON" == "1" ]]; then
    json_obj \
      "$(json_kv command version)" \
      "$(json_kv ok true --raw)" \
      "$(json_kv version "$OMES_VERSION")" \
      "$(json_kv exit_code 0 --raw)"
    printf '\n'
  else
    printf '[omes] omes %s\n' "$OMES_VERSION"
  fi
  exit "$OMES_EX_OK"
}

# _omes_json_result <command> <ok> <exit_code> [<extra-json-kv-pair>...]
# Emits {"command":...,"ok":...,<extra fields>...,"exit_code":...} as a
# single line on stdout (docs/cli.md's JSON contract: one object, no other
# stdout noise). <extra-json-kv-pair> are already-built "key":value
# fragments (from json_kv), inserted between "ok" and "exit_code".
_omes_json_result() {
  local command="$1" ok="$2" exit_code="$3"
  shift 3
  json_obj \
    "$(json_kv command "$command")" \
    "$(json_kv ok "$ok" --raw)" \
    "$@" \
    "$(json_kv exit_code "$exit_code" --raw)"
  printf '\n'
}

# _omes_json_die <command> <exit_code> <message...>
# In --json mode, first emits a single-object JSON error envelope
# ({"command":...,"ok":false,"error":"<message>","exit_code":...}) on
# stdout, then calls omes_die exactly like any other failure (redacted
# log line + exit <exit_code>) - the JSON object is complete and valid on
# stdout even though the process then exits via the normal log/exit path.
_omes_json_die() {
  local command="$1" exit_code="$2"
  shift 2
  local msg="$*"
  if [[ "$OMES_JSON" == "1" ]]; then
    _omes_json_result "$command" false "$exit_code" "$(json_kv error "$msg")"
  fi
  omes_die "$exit_code" "$msg"
}

cmd_help() {
  if [[ "$OMES_JSON" == "1" ]]; then
    _omes_json_result help true "$OMES_EX_OK" "$(json_kv usage "$(print_usage)")"
  else
    print_usage
  fi
  exit "$OMES_EX_OK"
}

_omes_resolve_modules() {
  if [[ -n "$OMES_PROFILE" ]]; then
    profile_load "$OMES_PROFILE"
  elif [[ "${#OMES_SELECTED_MODULES[@]}" -gt 0 ]]; then
    module_resolve_order "${OMES_SELECTED_MODULES[@]}"
  fi
}

# _omes_scope_followup_line
# Prints the exact follow-up command an operator should run to apply
# modules that were skipped for the other privilege scope.
_omes_scope_followup_line() {
  if [[ "$(module_current_scope)" == "root" ]]; then
    printf 'Run as your user: omes install --profile %s\n' "${OMES_PROFILE:-<profile>}"
  else
    printf 'Run with sudo: sudo omes install --profile %s\n' "${OMES_PROFILE:-<profile>}"
  fi
}

# _omes_check_explicit_module_scope <command> <name> [name...]
# Only meaningful when modules were selected via --module (not --profile):
# an explicit request naming a module of the wrong scope is a privilege
# usage error (exit 5), unlike a profile that simply mixes scopes.
_omes_check_explicit_module_scope() {
  local command="$1"
  shift
  [[ -z "$OMES_PROFILE" ]] || return 0
  # Only the modules the operator literally named count as "explicit".
  # Dependencies pulled in transitively through MODULE_REQUIRES may live
  # in the other scope (e.g. a root-scope session module that requires a
  # user-scope preflight module); those are filtered and reported like a
  # mixed profile, never treated as a privilege error.
  [[ "${#OMES_SELECTED_MODULES[@]}" -gt 0 ]] || return 0
  local -a bad=()
  mapfile -t bad < <(module_other_scope_modules "${OMES_SELECTED_MODULES[@]}")
  if [[ "${#bad[@]}" -gt 0 ]]; then
    _omes_json_die "$command" "$OMES_EX_PRIVILEGE" "requested module(s) do not match the current privilege level (current: $(module_current_scope)): ${bad[*]}"
  fi
}

cmd_check() {
  local -a names=()
  local -a oks=()
  local -a details=()

  detect_os || true
  detect_arch || true
  detect_tier >/dev/null || true
  detect_virt >/dev/null || true
  detect_session >/dev/null || true
  detect_privilege >/dev/null || true

  local net_ok=0
  if detect_network; then
    net_ok=1
  fi

  names+=("os")
  details+=("${OMES_OS_PRETTY:-unknown} (${OMES_OS_ID:-unknown} ${OMES_OS_VERSION_ID:-}) tier=${OMES_OS_TIER:-unsupported}")
  if [[ "${OMES_OS_TIER:-unsupported}" != "unsupported" ]]; then oks+=("true"); else oks+=("false"); fi

  names+=("arch")
  details+=("${OMES_ARCH:-unsupported}")
  if [[ "${OMES_ARCH:-unsupported}" != "unsupported" ]]; then oks+=("true"); else oks+=("false"); fi

  names+=("network")
  details+=("${OMES_NETWORK:-offline}")
  if [[ "$net_ok" -eq 1 ]]; then oks+=("true"); else oks+=("false"); fi

  local unsupported=0
  if [[ "${OMES_OS_TIER:-unsupported}" == "unsupported" ]] || [[ "${OMES_ARCH:-unsupported}" == "unsupported" ]]; then
    unsupported=1
  fi

  local -a modules=()
  if [[ "$unsupported" -eq 0 ]]; then
    mapfile -t modules < <(_omes_resolve_modules)
  fi

  # An explicit --module request naming a wrong-scope module is the only
  # scope-related failure for `check`; a --profile that simply mixes
  # scopes is filtered (skipped, not failed) below.
  if [[ "${#modules[@]}" -gt 0 ]]; then
    _omes_check_explicit_module_scope check "${modules[@]}"
  fi

  local -a in_scope=()
  local -a other_scope=()
  if [[ "${#modules[@]}" -gt 0 ]]; then
    mapfile -t in_scope < <(module_filter_by_scope "${modules[@]}")
    mapfile -t other_scope < <(module_other_scope_modules "${modules[@]}")
  fi

  local module_failed=0
  if [[ "${#in_scope[@]}" -gt 0 ]]; then
    if ! run_checks "${in_scope[@]}"; then
      module_failed=1
    fi
    local i
    for ((i = 0; i < ${#OMES_CHECK_NAMES[@]}; i++)); do
      names+=("${OMES_CHECK_NAMES[$i]}")
      oks+=("${OMES_CHECK_OK[$i]}")
      details+=("${OMES_CHECK_DETAILS[$i]}")
    done
  fi

  local m
  for m in "${other_scope[@]}"; do
    names+=("$m")
    oks+=("true")
    details+=("skipped: different privilege level (current: $(module_current_scope)); $(_omes_scope_followup_line)")
  done

  local exit_code="$OMES_EX_OK"
  local overall_ok="true"
  if [[ "$unsupported" -eq 1 ]]; then
    exit_code="$OMES_EX_UNSUPPORTED"
    overall_ok="false"
  elif [[ "$module_failed" -eq 1 ]]; then
    exit_code="$OMES_EX_PREFLIGHT"
    overall_ok="false"
  fi

  if [[ "$OMES_JSON" == "1" ]]; then
    local -a check_objs=()
    local j
    for ((j = 0; j < ${#names[@]}; j++)); do
      check_objs+=("$(json_obj "$(json_kv name "${names[$j]}")" "$(json_kv ok "${oks[$j]}" --raw)" "$(json_kv detail "${details[$j]}")")")
    done
    json_obj \
      "$(json_kv command check)" \
      "$(json_kv ok "$overall_ok" --raw)" \
      "$(json_kv platform "$(_omes_platform_json)" --raw)" \
      "$(json_kv checks "$(json_array "${check_objs[@]}")" --raw)" \
      "$(json_kv exit_code "$exit_code" --raw)"
    printf '\n'
  else
    printf '[omes] platform: %s %s (%s), arch=%s, tier=%s\n' \
      "${OMES_OS_PRETTY:-unknown}" "${OMES_OS_VERSION_ID:-}" "${OMES_OS_CODENAME:-}" "${OMES_ARCH:-unknown}" "${OMES_OS_TIER:-unsupported}"
    printf '[omes] checks:\n'
    local k mark
    for ((k = 0; k < ${#names[@]}; k++)); do
      mark="ok"
      [[ "${oks[$k]}" == "false" ]] && mark="FAIL"
      printf '[omes]   %-20s %-4s %s\n' "${names[$k]}" "$mark" "${details[$k]}"
    done
  fi

  exit "$exit_code"
}

cmd_install() {
  detect_os || true
  detect_arch || true
  detect_tier >/dev/null || true
  detect_privilege >/dev/null || true

  if [[ "${OMES_OS_TIER:-unsupported}" == "unsupported" ]] || [[ "${OMES_ARCH:-unsupported}" == "unsupported" ]]; then
    _omes_json_die install "$OMES_EX_UNSUPPORTED" "unsupported platform: ${OMES_OS_PRETTY:-unknown} / ${OMES_ARCH:-unknown} (before any mutation)"
  fi

  if [[ -z "$OMES_PROFILE" ]] && [[ "${#OMES_SELECTED_MODULES[@]}" -eq 0 ]]; then
    _omes_json_die install "$OMES_EX_USAGE" "install requires --profile <name> or --module <name>"
  fi

  local -a requested=()
  mapfile -t requested < <(_omes_resolve_modules)

  if [[ "${#requested[@]}" -eq 0 ]]; then
    _omes_json_die install "$OMES_EX_USAGE" "no modules resolved for this profile/module selection"
  fi

  # An explicit --module request naming a wrong-scope module is a
  # privilege usage error (exit 5, no mutation). A --profile that simply
  # mixes scopes is never an error: mismatched modules are filtered out
  # below and the operator is told the exact follow-up command.
  _omes_check_explicit_module_scope install "${requested[@]}"

  local -a in_scope=()
  local -a other_scope=()
  mapfile -t in_scope < <(module_filter_by_scope "${requested[@]}")
  mapfile -t other_scope < <(module_other_scope_modules "${requested[@]}")

  if [[ "${#other_scope[@]}" -gt 0 ]]; then
    log_info "skipping modules that require a different privilege level (current: $(module_current_scope)): ${other_scope[*]}"
  fi

  # Informational-only sudo preflight: never causes bin/omes to invoke
  # sudo itself, and never changes whether root-scope modules run now.
  if [[ "${#other_scope[@]}" -gt 0 ]] && [[ "$(module_current_scope)" == "user" ]] && command -v sudo >/dev/null 2>&1; then
    if sudo -n true 2>/dev/null; then
      log_info "sudo: passwordless sudo appears available for the root-scope follow-up run"
    else
      log_info "sudo: no cached/passwordless sudo detected; the root-scope follow-up run may prompt for a password"
    fi
  fi

  if [[ "${#in_scope[@]}" -eq 0 ]]; then
    log_info "nothing to apply at the current privilege level ($(module_current_scope))"
    if [[ "${#other_scope[@]}" -gt 0 ]]; then
      log_info "$(_omes_scope_followup_line)"
    fi
    if [[ "$OMES_JSON" == "1" ]]; then
      _omes_json_result install true "$OMES_EX_OK" "$(json_kv modules "$(json_array)" --raw)"
    fi
    exit "$OMES_EX_OK"
  fi

  log_info "plan: will apply modules: ${in_scope[*]}"

  if ! run_checks "${in_scope[@]}"; then
    local -a failed_objs=()
    local i
    for ((i = 0; i < ${#OMES_CHECK_NAMES[@]}; i++)); do
      if [[ "${OMES_CHECK_OK[$i]}" == "false" ]]; then
        log_error "check failed: ${OMES_CHECK_NAMES[$i]}: ${OMES_CHECK_DETAILS[$i]}"
        failed_objs+=("$(json_obj "$(json_kv name "${OMES_CHECK_NAMES[$i]}")" "$(json_kv detail "${OMES_CHECK_DETAILS[$i]}")")")
      fi
    done
    if [[ "$OMES_JSON" == "1" ]]; then
      _omes_json_result install false "$OMES_EX_PREFLIGHT" "$(json_kv failed_checks "$(json_array "${failed_objs[@]}")" --raw)"
    fi
    exit "$OMES_EX_PREFLIGHT"
  fi

  if omes_dry_run; then
    log_info "[dry-run] plan only, no mutation will occur"
  else
    if ! omes_confirm "About to apply modules: ${in_scope[*]}. Continue?"; then
      if [[ "$OMES_JSON" == "1" ]]; then
        _omes_json_result install false "$OMES_EX_ERROR" "$(json_kv error "aborted: confirmation required")"
      fi
      log_error "aborted: confirmation required (re-run with --yes to proceed non-interactively)"
      exit "$OMES_EX_ERROR"
    fi
    state_init >/dev/null
  fi

  run_apply "${in_scope[@]}"

  if [[ -n "$OMES_PROFILE" ]] && ! omes_dry_run; then
    state_set "omes.profile" "$OMES_PROFILE"
  fi

  if [[ "${#other_scope[@]}" -gt 0 ]]; then
    log_info "$(_omes_scope_followup_line)"
  fi

  log_info "install complete"

  if [[ "$OMES_JSON" == "1" ]]; then
    local -a mod_objs=()
    local m
    for m in "${in_scope[@]}"; do
      mod_objs+=("$(json_obj "$(json_kv name "$m")" "$(json_kv status "$(omes_dry_run && echo would-apply || echo applied)")")")
    done
    _omes_json_result install true "$OMES_EX_OK" "$(json_kv modules "$(json_array "${mod_objs[@]}")" --raw)"
  fi

  exit "$OMES_EX_OK"
}

# _omes_last_log_path
# Prints the path to the most recent log file under this scope's state
# dir (lexicographic order matches chronological order for the
# omes-<UTC timestamp>.log naming scheme - lib/omes/log.sh), or nothing if
# none exists yet.
_omes_last_log_path() {
  local dir
  dir="$(omes_state_dir)/logs"
  [[ -d "$dir" ]] || return 0
  local f latest=""
  for f in "$dir"/*.log; do
    [[ -e "$f" ]] || continue
    latest="$f"
  done
  if [[ -n "$latest" ]]; then
    printf '%s\n' "$latest"
  fi
  return 0
}

cmd_status() {
  detect_os || true
  detect_arch || true
  detect_tier >/dev/null || true

  local -a mod_names=()
  mapfile -t mod_names < <(state_list_modules)

  local profile
  profile="$(state_get "omes.profile" 2>/dev/null || true)"

  local -a backups=()
  mapfile -t backups < <(backup_list)

  local last_log
  last_log="$(_omes_last_log_path)"

  if [[ "$OMES_JSON" == "1" ]]; then
    local -a mod_objs=()
    local m status applied_at version
    for m in "${mod_names[@]}"; do
      status="$(state_get "module.${m}.status" 2>/dev/null || echo unknown)"
      applied_at="$(state_get "module.${m}.applied_at" 2>/dev/null || echo "")"
      version="$(state_get "module.${m}.version" 2>/dev/null || echo "")"
      mod_objs+=("$(json_obj "$(json_kv name "$m")" "$(json_kv status "$status")" "$(json_kv applied_at "$applied_at")" "$(json_kv version "$version")")")
    done
    json_obj \
      "$(json_kv command status)" \
      "$(json_kv ok true --raw)" \
      "$(json_kv platform "$(_omes_platform_json)" --raw)" \
      "$(json_kv profile "$profile")" \
      "$(json_kv state_dir "$(omes_state_dir)")" \
      "$(json_kv modules "$(json_array "${mod_objs[@]}")" --raw)" \
      "$(json_kv backup_count "${#backups[@]}" --raw)" \
      "$(json_kv last_log "$last_log")" \
      "$(json_kv exit_code 0 --raw)"
    printf '\n'
  else
    printf '[omes] platform: %s %s, arch=%s, tier=%s\n' \
      "${OMES_OS_PRETTY:-unknown}" "${OMES_OS_VERSION_ID:-}" "${OMES_ARCH:-unknown}" "${OMES_OS_TIER:-unsupported}"
    printf '[omes] profile: %s\n' "${profile:-none}"
    printf '[omes] state dir: %s\n' "$(omes_state_dir)"
    if [[ "${#mod_names[@]}" -eq 0 ]]; then
      printf '[omes] modules: none applied yet\n'
    else
      printf '[omes] modules:\n'
      local m status applied_at version
      for m in "${mod_names[@]}"; do
        status="$(state_get "module.${m}.status" 2>/dev/null || echo unknown)"
        applied_at="$(state_get "module.${m}.applied_at" 2>/dev/null || echo "-")"
        version="$(state_get "module.${m}.version" 2>/dev/null || echo "-")"
        printf '[omes]   %-20s %-10s applied_at=%-22s version=%s\n' "$m" "$status" "$applied_at" "$version"
      done
    fi
    printf '[omes] backups: %d session(s)\n' "${#backups[@]}"
    printf '[omes] last log: %s\n' "${last_log:-none}"
  fi

  exit "$OMES_EX_OK"
}

cmd_modules() {
  local -a all=()
  mapfile -t all < <(module_discover)

  if [[ "$OMES_JSON" == "1" ]]; then
    local -a objs=()
    local m status
    for m in "${all[@]}"; do
      module_load "$m"
      status="$(state_get "module.${m}.status" 2>/dev/null || echo not-applied)"
      objs+=("$(json_obj "$(json_kv name "$MODULE_NAME")" "$(json_kv description "$MODULE_DESCRIPTION")" "$(json_kv scope "$MODULE_SCOPE")" "$(json_kv status "$status")")")
    done
    json_obj \
      "$(json_kv command modules)" \
      "$(json_kv ok true --raw)" \
      "$(json_kv modules "$(json_array "${objs[@]}")" --raw)" \
      "$(json_kv exit_code 0 --raw)"
    printf '\n'
  else
    printf '[omes] modules:\n'
    local m status
    for m in "${all[@]}"; do
      module_load "$m"
      status="$(state_get "module.${m}.status" 2>/dev/null || echo not-applied)"
      printf '[omes]   %-16s scope=%-5s status=%-12s %s\n' "$MODULE_NAME" "$MODULE_SCOPE" "$status" "$MODULE_DESCRIPTION"
    done
  fi

  exit "$OMES_EX_OK"
}

# _omes_meta_get <meta-file> <key>
# Prints the value of <key> from a backup session's META file (same
# key=value format as the state file). Empty output when the file is
# unreadable or the key is absent.
_omes_meta_get() {
  local meta="$1" key="$2"
  [[ -r "$meta" ]] || return 0
  grep "^${key}=" "$meta" 2>/dev/null | head -n1 | cut -d= -f2-
}

cmd_backup() {
  local -a targets=()
  if [[ -n "${OMES_SELECTED_MODULES[0]:-}" ]]; then
    targets=("${OMES_SELECTED_MODULES[0]}")
  else
    mapfile -t targets < <(state_list_modules)
  fi

  local -a all_paths=()
  local m paths_str old_ifs
  for m in "${targets[@]}"; do
    paths_str="$(state_get "module.${m}.managed_paths" 2>/dev/null || true)"
    [[ -z "$paths_str" ]] && continue
    local -a mod_paths=()
    old_ifs="$IFS"
    IFS=':'
    read -r -a mod_paths <<< "$paths_str"
    IFS="$old_ifs"
    all_paths+=("${mod_paths[@]}")
  done

  if [[ "${#all_paths[@]}" -eq 0 ]]; then
    log_info "backup: no managed paths recorded for the requested module(s); nothing to back up"
    if [[ "$OMES_JSON" == "1" ]]; then
      json_obj "$(json_kv command backup)" "$(json_kv ok true --raw)" "$(json_kv backup_dir "")" "$(json_kv files_backed_up 0 --raw)" "$(json_kv exit_code 0 --raw)"
      printf '\n'
    fi
    exit "$OMES_EX_OK"
  fi

  if omes_dry_run; then
    log_info "[dry-run] would back up ${#all_paths[@]} managed path(s): ${all_paths[*]}"
    if [[ "$OMES_JSON" == "1" ]]; then
      json_obj "$(json_kv command backup)" "$(json_kv ok true --raw)" "$(json_kv backup_dir "")" "$(json_kv files_backed_up "${#all_paths[@]}" --raw)" "$(json_kv exit_code 0 --raw)"
      printf '\n'
    fi
    exit "$OMES_EX_OK"
  fi

  state_init >/dev/null

  local session_label="${OMES_SELECTED_MODULES[0]:-all}"
  backup_begin "$session_label" "${BACKUP_REASON:-manual}" >/dev/null
  local p
  for p in "${all_paths[@]}"; do
    backup_path "$p"
  done
  local dir
  dir="$(backup_finish)"
  # shellcheck disable=SC2119  # default retention comes from OMES_BACKUP_KEEP
  backup_prune

  log_info "backup: created $(basename "$dir") (${#all_paths[@]} path(s))"

  if [[ "$OMES_JSON" == "1" ]]; then
    json_obj \
      "$(json_kv command backup)" \
      "$(json_kv ok true --raw)" \
      "$(json_kv backup_dir "$dir")" \
      "$(json_kv files_backed_up "${#all_paths[@]}" --raw)" \
      "$(json_kv exit_code 0 --raw)"
    printf '\n'
  fi

  exit "$OMES_EX_OK"
}

cmd_restore() {
  if [[ "$RESTORE_LIST" == "1" ]]; then
    local -a sessions=()
    mapfile -t sessions < <(backup_list)

    if [[ "$OMES_JSON" == "1" ]]; then
      local -a objs=()
      local s meta
      for s in "${sessions[@]}"; do
        meta="$(omes_state_dir)/backups/${s}/META"
        objs+=("$(json_obj \
          "$(json_kv timestamp "$s")" \
          "$(json_kv module "$(_omes_meta_get "$meta" module)")" \
          "$(json_kv reason "$(_omes_meta_get "$meta" reason)")" \
          "$(json_kv started_at "$(_omes_meta_get "$meta" started_at)")")")
      done
      json_obj \
        "$(json_kv command restore)" \
        "$(json_kv ok true --raw)" \
        "$(json_kv backups "$(json_array "${objs[@]}")" --raw)" \
        "$(json_kv exit_code 0 --raw)"
      printf '\n'
    else
      if [[ "${#sessions[@]}" -eq 0 ]]; then
        printf '[omes] restore: no backups available\n'
      else
        printf '[omes] backups (oldest first):\n'
        local s meta
        for s in "${sessions[@]}"; do
          meta="$(omes_state_dir)/backups/${s}/META"
          printf '[omes]   %-18s module=%-14s reason=%s\n' \
            "$s" "$(_omes_meta_get "$meta" module)" "$(_omes_meta_get "$meta" reason)"
        done
      fi
    fi
    exit "$OMES_EX_OK"
  fi

  if ! omes_dry_run; then
    if ! omes_confirm "Restore from backup ${RESTORE_FROM:-<latest>}? Current files are backed up first."; then
      log_error "aborted: confirmation required (re-run with --yes to proceed non-interactively)"
      exit "$OMES_EX_ERROR"
    fi
  fi

  if restore_backup "$RESTORE_FROM"; then
    if [[ "$OMES_JSON" == "1" ]]; then
      json_obj "$(json_kv command restore)" "$(json_kv ok true --raw)" "$(json_kv exit_code 0 --raw)"
      printf '\n'
    else
      log_info "restore: complete"
    fi
    exit "$OMES_EX_OK"
  fi

  if [[ "$OMES_JSON" == "1" ]]; then
    json_obj "$(json_kv command restore)" "$(json_kv ok false --raw)" "$(json_kv exit_code "$OMES_EX_BACKUP" --raw)"
    printf '\n'
  fi
  exit "$OMES_EX_BACKUP"
}

# _omes_uninstall_report_packages <module>
# Prints the packages OMES recorded as installed by <module> and the exact
# `apt-get remove` command an operator could run - unconditionally (this
# is the "print by default" half of the --purge-packages policy).
_omes_uninstall_report_packages() {
  local mod="$1"
  local installed
  installed="$(state_get "module.${mod}.installed_packages" 2>/dev/null || true)"
  [[ -n "$installed" ]] || return 0

  local -a pkgs=()
  local old_ifs="$IFS"
  IFS=':'
  read -r -a pkgs <<< "$installed"
  IFS="$old_ifs"

  log_info "uninstall: '${mod}' installed these packages (kept unless --purge-packages): ${pkgs[*]}"
  log_info "uninstall: to remove them yourself: apt-get remove ${pkgs[*]}"
}

# _omes_uninstall_handle_packages <module>
# Always reports (see above); additionally purges via `apt-get remove`
# when PURGE_PACKAGES=1 - and ONLY the packages recorded as installed by
# THIS module (never anything else), clearing that state key once removed
# so a re-run does not try to remove them again.
_omes_uninstall_handle_packages() {
  local mod="$1"
  local installed
  installed="$(state_get "module.${mod}.installed_packages" 2>/dev/null || true)"

  _omes_uninstall_report_packages "$mod"

  [[ -n "$installed" ]] || return 0
  [[ "$PURGE_PACKAGES" == "1" ]] || return 0

  local -a pkgs=()
  local old_ifs="$IFS"
  IFS=':'
  read -r -a pkgs <<< "$installed"
  IFS="$old_ifs"

  if ! DEBIAN_FRONTEND=noninteractive omes_run apt-get remove -y "${pkgs[@]}"; then
    omes_die "$OMES_EX_ROLLBACK" "uninstall: apt-get remove failed for module: ${mod}"
  fi

  state_unset "module.${mod}.installed_packages"
}

cmd_uninstall() {
  local -a state_modules=()
  mapfile -t state_modules < <(state_list_modules)

  # Resolve target modules FROM STATE ONLY - a --profile/--module request
  # names candidates, but uninstall never touches a module OMES never
  # recorded as applied (docs/scope.md Section 5: "removes only the
  # files/services/configuration OMES itself recorded as managed").
  local -a requested=()
  if [[ -n "$OMES_PROFILE" ]]; then
    local -a profile_mods=()
    mapfile -t profile_mods < <(profile_load "$OMES_PROFILE")
    local pm sm
    for pm in "${profile_mods[@]}"; do
      for sm in "${state_modules[@]}"; do
        if [[ "$pm" == "$sm" ]]; then
          requested+=("$pm")
          break
        fi
      done
    done
  elif [[ "${#OMES_SELECTED_MODULES[@]}" -gt 0 ]]; then
    local wm sm found
    for wm in "${OMES_SELECTED_MODULES[@]}"; do
      found=0
      for sm in "${state_modules[@]}"; do
        [[ "$wm" == "$sm" ]] && found=1 && break
      done
      if [[ "$found" -eq 0 ]]; then
        log_info "uninstall: module '${wm}' has no recorded state; nothing to do"
        continue
      fi
      requested+=("$wm")
    done
  else
    requested=("${state_modules[@]}")
  fi

  local -a active=()
  local m status
  for m in "${requested[@]}"; do
    status="$(state_get "module.${m}.status" 2>/dev/null || echo unknown)"
    if [[ "$status" == "removed" ]]; then
      log_info "uninstall: module '${m}' is already removed; skipping"
      continue
    fi
    active+=("$m")
  done

  if [[ "${#active[@]}" -eq 0 ]]; then
    log_info "uninstall: nothing to do"
    if [[ "$OMES_JSON" == "1" ]]; then
      json_obj "$(json_kv command uninstall)" "$(json_kv ok true --raw)" "$(json_kv modules "$(json_array)" --raw)" "$(json_kv exit_code 0 --raw)"
      printf '\n'
    fi
    exit "$OMES_EX_OK"
  fi

  # Same scope convention as check/install (Section 4.5): an explicit
  # --module naming a wrong-scope module is a privilege usage error
  # (exit 5, no mutation); a resolved set that simply mixes scopes is
  # filtered, not failed.
  _omes_check_explicit_module_scope uninstall "${active[@]}"

  local -a in_scope=()
  local -a other_scope=()
  mapfile -t in_scope < <(module_filter_by_scope "${active[@]}")
  mapfile -t other_scope < <(module_other_scope_modules "${active[@]}")

  if [[ "${#other_scope[@]}" -gt 0 ]]; then
    log_info "uninstall: skipping modules that require a different privilege level (current: $(module_current_scope)): ${other_scope[*]}"
  fi

  if [[ "${#in_scope[@]}" -eq 0 ]]; then
    log_info "uninstall: nothing to uninstall at the current privilege level ($(module_current_scope))"
    exit "$OMES_EX_OK"
  fi

  # Reverse dependency order: dependents removed before their
  # dependencies (the opposite of install's apply order).
  # module_resolve_order expands MODULE_REQUIRES transitively (what
  # install needs); uninstall must not cascade into dependencies the
  # operator did not ask to remove, so keep only the selected modules.
  local -a expanded=()
  mapfile -t expanded < <(module_resolve_order "${in_scope[@]}")
  local -a order=()
  local e s
  for e in "${expanded[@]}"; do
    for s in "${in_scope[@]}"; do
      if [[ "$e" == "$s" ]]; then
        order+=("$e")
        break
      fi
    done
  done
  local -a reverse=()
  local i
  for ((i = ${#order[@]} - 1; i >= 0; i--)); do
    reverse+=("${order[$i]}")
  done

  if ! omes_dry_run; then
    if ! omes_confirm "Uninstall modules: ${reverse[*]}?"; then
      log_error "aborted: confirmation required (re-run with --yes to proceed non-interactively)"
      exit "$OMES_EX_ERROR"
    fi
  fi

  local -a results=()
  for m in "${reverse[@]}"; do
    module_load "$m"
    log_info "uninstall: rolling back module: ${m}"

    if ! module_rollback; then
      if omes_dry_run; then
        log_warn "uninstall: [dry-run] module_rollback reported a failure for: ${m} (continuing, dry-run)"
      else
        omes_die "$OMES_EX_ROLLBACK" "uninstall: module_rollback failed: ${m}"
      fi
    fi

    if ! module_rollback_managed_paths "$m"; then
      if omes_dry_run; then
        log_warn "uninstall: [dry-run] managed-path rollback reported a failure for: ${m} (continuing, dry-run)"
      else
        omes_die "$OMES_EX_ROLLBACK" "uninstall: failed to roll back managed paths for: ${m}"
      fi
    fi

    if omes_dry_run; then
      _omes_uninstall_report_packages "$m"
      results+=("$(json_obj "$(json_kv name "$m")" "$(json_kv status would-remove)")")
      continue
    fi

    _omes_uninstall_handle_packages "$m"

    state_set "module.${m}.status" "removed"
    state_set "module.${m}.removed_at" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    results+=("$(json_obj "$(json_kv name "$m")" "$(json_kv status removed)")")
    log_info "uninstall: module removed: ${m}"
  done

  if [[ "$OMES_JSON" == "1" ]]; then
    json_obj \
      "$(json_kv command uninstall)" \
      "$(json_kv ok true --raw)" \
      "$(json_kv modules "$(json_array "${results[@]}")" --raw)" \
      "$(json_kv exit_code 0 --raw)"
    printf '\n'
  else
    log_info "uninstall: complete"
  fi

  exit "$OMES_EX_OK"
}

# ---------------------------------------------------------------------------
# omes doctor
# ---------------------------------------------------------------------------

declare -a DOCTOR_NAMES=()
declare -a DOCTOR_LEVELS=()
declare -a DOCTOR_DETAILS=()

# _doctor_check <name> <level> <detail>
# Records one doctor check result. <level> is one of OK/WARN/FAIL.
_doctor_check() {
  DOCTOR_NAMES+=("$1")
  DOCTOR_LEVELS+=("$2")
  DOCTOR_DETAILS+=("$3")
}

cmd_doctor() {
  DOCTOR_NAMES=()
  DOCTOR_LEVELS=()
  DOCTOR_DETAILS=()

  detect_os || true
  detect_arch || true
  detect_tier >/dev/null || true

  # 1. Platform tier.
  if [[ "${OMES_OS_TIER:-unsupported}" == "unsupported" ]]; then
    _doctor_check platform FAIL "${OMES_OS_PRETTY:-unknown} / ${OMES_ARCH:-unknown} is unsupported"
  else
    _doctor_check platform OK "${OMES_OS_PRETTY:-unknown} (${OMES_OS_ID:-unknown}), arch=${OMES_ARCH:-unknown}, tier=${OMES_OS_TIER}"
  fi

  # 2. Required commands (advisory: a module using apt might not need all
  # of these on a non-Debian host, but every currently supported platform
  # is Debian-family, so their absence is at least a WARN).
  local cmd
  for cmd in bash sha256sum dpkg-query apt-get apt-cache git; do
    if command -v "$cmd" >/dev/null 2>&1; then
      _doctor_check "cmd:${cmd}" OK "found on PATH"
    else
      _doctor_check "cmd:${cmd}" WARN "not found on PATH"
    fi
  done

  # 3. State dir integrity and permissions.
  local sd
  sd="$(omes_state_dir)"
  if [[ -d "$sd" ]]; then
    local mode
    mode="$(stat -c '%a' "$sd" 2>/dev/null || printf '?')"
    if [[ "$mode" == "700" ]]; then
      _doctor_check state_dir OK "${sd} (mode ${mode})"
    else
      _doctor_check state_dir WARN "${sd} has mode ${mode} (expected 700)"
    fi
    if [[ -f "${sd}/state" ]]; then
      local smode
      smode="$(stat -c '%a' "${sd}/state" 2>/dev/null || printf '?')"
      if [[ "$smode" == "600" ]]; then
        _doctor_check state_file OK "mode 600"
      else
        _doctor_check state_file WARN "${sd}/state has mode ${smode} (expected 600)"
      fi
    fi
  else
    _doctor_check state_dir OK "${sd} does not exist yet (nothing applied)"
  fi

  # 4. Applied modules' module_verify, plus an optional module_doctor
  # hook (lib/omes/module.sh's contract only requires
  # check/apply/verify/rollback; module_doctor is an additive, optional
  # convention a module may define for deeper self-diagnosis).
  local -a mod_names=()
  mapfile -t mod_names < <(state_list_modules)
  local m mstatus
  for m in "${mod_names[@]}"; do
    mstatus="$(state_get "module.${m}.status" 2>/dev/null || echo unknown)"
    if [[ "$mstatus" != "applied" ]]; then
      _doctor_check "module:${m}" WARN "status=${mstatus} (not currently applied)"
      continue
    fi
    if [[ ! -r "${OMES_ROOT}/modules/${m}/module.sh" ]]; then
      _doctor_check "module:${m}" WARN "module.sh no longer present on disk"
      continue
    fi

    module_load "$m"

    if [[ "$MODULE_SCOPE" == "root" ]] && ! omes_is_root; then
      _doctor_check "module:${m}" WARN "requires root to verify (run: sudo omes doctor)"
      continue
    fi
    if [[ "$MODULE_SCOPE" == "user" ]] && omes_is_root; then
      _doctor_check "module:${m}" WARN "must not run as root to verify"
      continue
    fi

    if module_verify >/dev/null 2>&1; then
      _doctor_check "module:${m}" OK "verified"
    else
      _doctor_check "module:${m}" FAIL "module_verify failed"
    fi

    if declare -F module_doctor >/dev/null 2>&1; then
      local mdout="" mdrc=0
      mdout="$(module_doctor 2>&1)" || mdrc=$?
      if [[ "$mdrc" -eq 0 ]]; then
        _doctor_check "module:${m}:doctor" OK "${mdout:-ok}"
      else
        _doctor_check "module:${m}:doctor" WARN "${mdout:-module_doctor reported an issue}"
      fi
    fi
  done

  # 5. Backup availability.
  local -a backups=()
  mapfile -t backups < <(backup_list)
  _doctor_check backups OK "${#backups[@]} session(s) available"

  # 6. Log writability.
  local logdir="${sd}/logs"
  if mkdir -p "$logdir" 2>/dev/null && [[ -w "$logdir" ]]; then
    _doctor_check log_writable OK "$logdir"
  else
    _doctor_check log_writable FAIL "${logdir} is not writable"
  fi

  local overall_fail=0
  local i
  for i in "${!DOCTOR_LEVELS[@]}"; do
    [[ "${DOCTOR_LEVELS[$i]}" == "FAIL" ]] && overall_fail=1
  done
  local exit_code="$OMES_EX_OK"
  local overall_ok="true"
  if [[ "$overall_fail" -eq 1 ]]; then
    exit_code="$OMES_EX_ERROR"
    overall_ok="false"
  fi

  if [[ "$OMES_JSON" == "1" ]]; then
    local -a check_objs=()
    for i in "${!DOCTOR_NAMES[@]}"; do
      check_objs+=("$(json_obj "$(json_kv name "${DOCTOR_NAMES[$i]}")" "$(json_kv level "${DOCTOR_LEVELS[$i]}")" "$(json_kv detail "${DOCTOR_DETAILS[$i]}")")")
    done
    _omes_json_result doctor "$overall_ok" "$exit_code" "$(json_kv checks "$(json_array "${check_objs[@]}")" --raw)"
  else
    printf '[omes] doctor:\n'
    for i in "${!DOCTOR_NAMES[@]}"; do
      printf '[omes]   %-22s %-4s %s\n' "${DOCTOR_NAMES[$i]}" "${DOCTOR_LEVELS[$i]}" "${DOCTOR_DETAILS[$i]}"
    done
  fi

  exit "$exit_code"
}

# ---------------------------------------------------------------------------
# omes update
# ---------------------------------------------------------------------------

# cmd_update
# Updates the OMES checkout itself via git (fetch + fast-forward only),
# then re-runs `omes check` (never auto-applies any module). Refuses on a
# dirty working tree or a detached HEAD - either would make a
# fast-forward merge ambiguous or unsafe to auto-resolve.
cmd_update() {
  if ! command -v git >/dev/null 2>&1; then
    _omes_json_die update "$OMES_EX_ERROR" "update: git not found on PATH"
  fi

  if ! git -C "$OMES_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    _omes_json_die update "$OMES_EX_ERROR" "update: ${OMES_ROOT} is not a git checkout (omes was not installed via git clone)"
  fi

  if [[ -n "$(git -C "$OMES_ROOT" status --porcelain 2>/dev/null)" ]]; then
    _omes_json_die update "$OMES_EX_ERROR" "update: refusing to update - the working tree has local changes (git status --porcelain is non-empty)"
  fi

  local branch
  branch="$(git -C "$OMES_ROOT" symbolic-ref --short -q HEAD || true)"
  if [[ -z "$branch" ]]; then
    _omes_json_die update "$OMES_EX_ERROR" "update: refusing to update - HEAD is detached (not on a branch)"
  fi

  if omes_dry_run; then
    log_info "[dry-run] would run: git -C ${OMES_ROOT} fetch, then git -C ${OMES_ROOT} merge --ff-only"
    if [[ "$OMES_JSON" == "1" ]]; then
      _omes_json_result update true "$OMES_EX_OK" "$(json_kv branch "$branch")"
    fi
    exit "$OMES_EX_OK"
  fi

  if ! detect_network; then
    _omes_json_die update "$OMES_EX_NETWORK" "update: network required to fetch, but network is unavailable"
  fi

  local before
  before="$(git -C "$OMES_ROOT" rev-parse HEAD)"

  if ! omes_run git -C "$OMES_ROOT" fetch --quiet; then
    _omes_json_die update "$OMES_EX_ERROR" "update: git fetch failed"
  fi

  if ! omes_run git -C "$OMES_ROOT" merge --ff-only --quiet; then
    _omes_json_die update "$OMES_EX_ERROR" "update: fast-forward merge failed (local branch has diverged from its upstream, or no upstream is configured for '${branch}')"
  fi

  local after
  after="$(git -C "$OMES_ROOT" rev-parse HEAD)"
  log_info "update: ${branch} ${before} -> ${after}"

  if [[ "$before" == "$after" ]]; then
    log_info "update: already up to date"
  fi

  log_info "update: re-running 'omes check' (never auto-applies any module)"
  # cmd_check exits internally with its own contract-compliant output
  # (human or --json); on a successful update, `omes update`'s final
  # output IS `omes check`'s output for the freshly-updated checkout -
  # documented explicitly in docs/cli.md rather than duplicating check's
  # entire platform/module report under a second JSON envelope.
  cmd_check
}

# ---------------------------------------------------------------------------
# Argument parsing + dispatch
# ---------------------------------------------------------------------------

main() {
  if [[ $# -eq 0 ]]; then
    print_usage
    exit "$OMES_EX_USAGE"
  fi

  local command="$1"
  shift
  local -a OMES_CMD_ARGS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || omes_die "$OMES_EX_USAGE" "--profile requires an argument"
        OMES_PROFILE="$2"
        shift 2
        ;;
      --module)
        [[ $# -ge 2 ]] || omes_die "$OMES_EX_USAGE" "--module requires an argument"
        OMES_SELECTED_MODULES+=("$2")
        shift 2
        ;;
      --dry-run)
        OMES_DRY_RUN=1
        shift
        ;;
      --json)
        OMES_JSON=1
        shift
        ;;
      --yes)
        OMES_NONINTERACTIVE=1
        shift
        ;;
      --verbose)
        OMES_VERBOSE=1
        shift
        ;;
      --log-file)
        [[ $# -ge 2 ]] || omes_die "$OMES_EX_USAGE" "--log-file requires an argument"
        OMES_LOG_FILE="$2"
        shift 2
        ;;
      --allow-docker-group)
        OMES_ALLOW_DOCKER_GROUP=1
        shift
        ;;
      --from)
        [[ $# -ge 2 ]] || omes_die "$OMES_EX_USAGE" "--from requires an argument"
        RESTORE_FROM="$2"
        shift 2
        ;;
      --list)
        RESTORE_LIST=1
        shift
        ;;
      --reason)
        [[ $# -ge 2 ]] || omes_die "$OMES_EX_USAGE" "--reason requires an argument"
        BACKUP_REASON="$2"
        shift 2
        ;;
      --purge-packages)
        PURGE_PACKAGES=1
        shift
        ;;
      -h | --help)
        command="help"
        shift
        ;;
      *)
        if _omes_is_extension_command "$command"; then
          # Everything from here on belongs to the extension command.
          OMES_CMD_ARGS=("$@")
          break
        fi
        omes_die "$OMES_EX_USAGE" "unknown option: $1"
        ;;
    esac
  done

  export OMES_DRY_RUN="${OMES_DRY_RUN:-0}"
  export OMES_JSON="${OMES_JSON:-0}"
  export OMES_VERBOSE="${OMES_VERBOSE:-0}"
  export OMES_NONINTERACTIVE="${OMES_NONINTERACTIVE:-0}"
  if [[ -n "${OMES_LOG_FILE:-}" ]]; then
    export OMES_LOG_FILE
  fi
  export RESTORE_FROM RESTORE_LIST BACKUP_REASON PURGE_PACKAGES OMES_ALLOW_DOCKER_GROUP

  case "$command" in
    check) cmd_check ;;
    install) cmd_install ;;
    status) cmd_status ;;
    modules) cmd_modules ;;
    version) cmd_version ;;
    backup) cmd_backup ;;
    restore) cmd_restore ;;
    uninstall) cmd_uninstall ;;
    doctor) cmd_doctor ;;
    update) cmd_update ;;
    help) cmd_help ;;
    *)
      if _omes_is_extension_command "$command"; then
        _omes_run_extension_command "$command" "${OMES_CMD_ARGS[@]}"
      else
        omes_die "$OMES_EX_USAGE" "unknown command: $command"
      fi
      ;;
  esac
}

main "$@"
